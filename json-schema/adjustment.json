{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Adjustment",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "type": {
      "$ref": "#/components/schemas/AdjustmentTypeEnum"
    },
    "value": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,7}(?:\\.\\d{0,8})?$"
    },
    "name": {
      "type": "string",
      "nullable": true
    }
  },
  "required": [
    "type",
    "value"
  ]
}