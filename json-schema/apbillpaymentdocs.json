{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "APBillPaymentDocs",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "readOnly": true
    },
    "payment": {
      "$ref": "#/components/schemas/PaymentSimpleDocs"
    },
    "payment_method": {
      "$ref": "#/components/schemas/PaymentMethodDocs"
    },
    "amount": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,13}(?:\\.\\d{0,8})?$",
      "title": "Payment Amount"
    },
    "transaction": {
      "type": "integer",
      "nullable": true
    }
  },
  "required": [
    "payment",
    "payment_method"
  ]
}