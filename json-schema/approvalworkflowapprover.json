{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApprovalWorkflowApprover",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "profile_image": {
      "type": "string",
      "nullable": true
    },
    "approval_delegatee": {
      "allOf": [
        {
          "$ref": "#/components/schemas/ApprovalDelegatee"
        }
      ],
      "nullable": true,
      "type": "object"
    }
  },
  "required": [
    "email",
    "firstName",
    "id",
    "lastName"
  ]
}