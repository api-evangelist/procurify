{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Attachment",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "readOnly": true
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "file": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "maxLength": 255
    },
    "user": {
      "type": "integer"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "mimetype": {
      "type": "string",
      "maxLength": 100
    },
    "length": {
      "type": "integer",
      "maximum": 2147483647,
      "minimum": -2147483648,
      "nullable": true
    },
    "sha1_hash": {
      "type": "string",
      "maxLength": 40
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    }
  },
  "required": [
    "file",
    "user",
    "uuid"
  ]
}