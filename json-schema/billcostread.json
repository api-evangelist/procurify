{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BillCostRead",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "readOnly": true
    },
    "cost_allocation": {
      "$ref": "#/components/schemas/CostAllocationRead"
    },
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "amount": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,13}(?:\\.\\d{0,8})?$"
    },
    "bill": {
      "type": "integer"
    },
    "cost": {
      "type": "integer",
      "nullable": true,
      "title": "Cost Class"
    },
    "currency": {
      "type": "integer",
      "nullable": true
    }
  },
  "required": [
    "amount",
    "bill",
    "cost_allocation",
    "name"
  ]
}