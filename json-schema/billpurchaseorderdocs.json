{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BillPurchaseOrderDocs",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "number": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "total_amount": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,13}(?:\\.\\d{0,2})?$"
    }
  },
  "required": [
    "currency",
    "id",
    "number",
    "total_amount"
  ]
}