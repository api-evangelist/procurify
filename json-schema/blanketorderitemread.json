{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BlanketOrderItemRead",
  "type": "object",
  "properties": {
    "price": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,13}(?:\\.\\d{0,8})?$"
    },
    "quantity": {
      "type": "number",
      "format": "double",
      "nullable": true,
      "readOnly": true
    },
    "amount": {
      "type": "number",
      "format": "double",
      "nullable": true,
      "readOnly": true
    }
  },
  "required": [
    "price"
  ]
}