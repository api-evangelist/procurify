{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BreakdownDocs",
  "type": "object",
  "properties": {
    "score": {
      "type": "number",
      "format": "double"
    },
    "weight": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,1}(?:\\.\\d{0,1})?$"
    }
  },
  "required": [
    "score",
    "weight"
  ]
}