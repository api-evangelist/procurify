{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CatalogItemBundleRead",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 250
    },
    "image": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/CatalogItemReadSerializerWithQuantity"
      },
      "readOnly": true
    },
    "items_count": {
      "type": "integer",
      "readOnly": true
    }
  },
  "required": [
    "name"
  ]
}