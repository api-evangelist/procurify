{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CostDetails",
  "type": "object",
  "properties": {
    "subtotal": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,8}(?:\\.\\d{0,8})?$",
      "nullable": true
    },
    "total_cost": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,8}(?:\\.\\d{0,8})?$"
    },
    "total_cost_in_base_currency": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,8}(?:\\.\\d{0,8})?$"
    },
    "tax_amount": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,8}(?:\\.\\d{0,8})?$"
    }
  },
  "required": [
    "tax_amount",
    "total_cost",
    "total_cost_in_base_currency"
  ]
}