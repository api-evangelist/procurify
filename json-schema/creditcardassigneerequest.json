{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreditCardAssigneeRequest",
  "type": "object",
  "properties": {
    "firstName": {
      "type": "string",
      "maxLength": 100
    },
    "lastName": {
      "type": "string",
      "maxLength": 100
    },
    "email": {
      "type": "string",
      "format": "email",
      "minLength": 1,
      "maxLength": 254
    },
    "profile_image": {
      "type": "string",
      "format": "binary",
      "nullable": true
    }
  },
  "required": [
    "email"
  ]
}