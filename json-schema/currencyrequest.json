{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CurrencyRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10
    },
    "description": {
      "type": "string",
      "maxLength": 100
    },
    "rate": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,9}(?:\\.\\d{0,6})?$"
    },
    "base": {
      "type": "boolean"
    },
    "active": {
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "rate"
  ]
}