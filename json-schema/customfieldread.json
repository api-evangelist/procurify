{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CustomFieldRead",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "content_type": {
      "type": "integer"
    },
    "default_value": {
      "type": "string",
      "maxLength": 5000
    },
    "is_required": {
      "type": "boolean"
    },
    "field_choices": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "readOnly": true
    },
    "field_type": {
      "$ref": "#/components/schemas/FieldTypeEnum"
    },
    "field_label": {
      "type": "string",
      "readOnly": true
    },
    "is_active": {
      "type": "boolean",
      "readOnly": true
    }
  },
  "required": [
    "content_type",
    "name"
  ]
}