{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DepartmentUpsertRequest",
  "type": "object",
  "properties": {
    "branch": {
      "type": "integer"
    },
    "external_id": {
      "type": "string",
      "nullable": true,
      "description": "External id",
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "active": {
      "type": "boolean"
    },
    "punchout_email": {
      "type": "string",
      "nullable": true,
      "minLength": 1
    }
  },
  "required": [
    "branch",
    "name"
  ]
}