{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PermissionGroupRead",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "maxLength": 150
    },
    "user_count": {
      "type": "integer",
      "readOnly": true
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/PermissionRead"
      },
      "readOnly": true
    },
    "type": {
      "type": "integer"
    },
    "tier": {
      "type": "string",
      "readOnly": true
    }
  },
  "required": [
    "name",
    "type"
  ]
}