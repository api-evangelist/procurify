{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PurchaseOrderBillingHistoryItem",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "billed_qty": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,13}(?:\\.\\d{0,8})?$",
      "default": "0.00000000"
    },
    "received_qty": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,10}(?:\\.\\d{0,5})?$",
      "default": "0.00000"
    }
  },
  "required": [
    "id"
  ]
}