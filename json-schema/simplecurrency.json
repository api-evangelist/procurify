{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SimpleCurrency",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "maxLength": 10
    },
    "rate": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,9}(?:\\.\\d{0,6})?$"
    }
  },
  "required": [
    "name",
    "rate"
  ]
}