{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SimpleUserProfile",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "readOnly": true
    },
    "firstName": {
      "type": "string",
      "maxLength": 100
    },
    "lastName": {
      "type": "string",
      "maxLength": 100
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "role": {
      "allOf": [
        {
          "$ref": "#/components/schemas/MinimalRoleRead"
        }
      ],
      "readOnly": true
    },
    "profile_image": {
      "type": "string",
      "nullable": true
    }
  },
  "required": [
    "email"
  ]
}