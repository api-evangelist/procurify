{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StatementItem",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "readOnly": true
    },
    "creditcard": {
      "type": "integer",
      "title": "Credit Card"
    },
    "statement": {
      "type": "integer",
      "nullable": true
    },
    "match": {
      "type": "integer",
      "nullable": true
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string",
      "maxLength": 255
    },
    "amount": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,9}(?:\\.\\d{0,2})?$"
    },
    "duplicate_of": {
      "type": "integer",
      "nullable": true
    }
  },
  "required": [
    "amount",
    "creditcard"
  ]
}