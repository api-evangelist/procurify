{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserProfileRead",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "readOnly": true
    },
    "firstName": {
      "type": "string",
      "maxLength": 100
    },
    "lastName": {
      "type": "string",
      "maxLength": 100
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "department": {
      "allOf": [
        {
          "$ref": "#/components/schemas/SimpleDepartment"
        }
      ],
      "nullable": true,
      "type": "object"
    }
  },
  "required": [
    "department",
    "email"
  ]
}